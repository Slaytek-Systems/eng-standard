import { v } from "convex/values";
import type { FunctionHandle } from "convex/server";
import { mutation } from "./_generated/server";

export const enqueue = mutation({
  args: { payload: v.any(), onCompleteFnHandle: v.string() },
  returns: v.null(),
  handler: async (ctx, args) => {
    const onComplete = args.onCompleteFnHandle as FunctionHandle<"mutation", { jobId: string }>;
    await ctx.scheduler.runAfter(0, onComplete, { jobId: "j1" });
    return null;
  },
});
